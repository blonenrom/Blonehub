-- Noclip
local wallNames = {"wall","fence","door","gate","barrier","pillar","column","invisible"}
local function isGround(part)
    if not part:IsA("BasePart") then return false end
    if part.Transparency > 0.5 then return false end
    local nameLower = part.Name:lower()
    for _,w in ipairs(wallNames) do if nameLower:find(w) then return false end end
    if part.Material == Enum.Material.Grass or part.Material == Enum.Material.Slate or part.Material == Enum.Material.Sand then return true end
    if part.Anchored then
        local size = part.Size
        if size.Y < 5 and size.X > 10 and size.Z > 10 then
            local ratioX = size.X / math.max(size.Y,0.1); local ratioZ = size.Z / math.max(size.Y,0.1)
            if ratioX > 3 or ratioZ > 3 then return true end
        end
    end
    return false
end

local worldCollisionBackup = {}
local worldTransparencyBackup = {}
local function setWorldCollisions(enabled)
    local function processObjects()
        local function recurse(obj)
            if obj:IsA("BasePart") then
                local car = getCar()
                if not (obj:IsDescendantOf(car or {}) or obj:IsDescendantOf(player.Character or {})) then
                    if isGround(obj) then return end
                    if enabled then
                        if worldCollisionBackup[obj] ~= nil then obj.CanCollide = worldCollisionBackup[obj]; worldCollisionBackup[obj] = nil end
                        if worldTransparencyBackup[obj] ~= nil then obj.Transparency = worldTransparencyBackup[obj]; worldTransparencyBackup[obj] = nil end
                    else
                        if worldCollisionBackup[obj] == nil then worldCollisionBackup[obj] = obj.CanCollide end
                        obj.CanCollide = false
                        if transparentObstacles then
                            if worldTransparencyBackup[obj] == nil then worldTransparencyBackup[obj] = obj.Transparency end
                            obj.Transparency = 0.7
                        end
                    end
                end
            end
            for _, child in ipairs(obj:GetChildren()) do recurse(child) end
        end
        recurse(workspace)
    end
    if collisionUpdateLoop then collisionUpdateLoop:Disconnect(); collisionUpdateLoop = nil end
    if not enabled then processObjects()
    else
        processObjects()
        collisionUpdateLoop = RunService.Heartbeat:Connect(function()
            if not isFarming then collisionUpdateLoop:Disconnect(); collisionUpdateLoop=nil; return end
            if not collisionUpdateLoop.LastUpdate then collisionUpdateLoop.LastUpdate = tick() end
            if tick() - collisionUpdateLoop.LastUpdate >= 3 then processObjects(); collisionUpdateLoop.LastUpdate = tick() end
        end)
    end
end

