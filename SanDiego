local function applyTheme(name)
    local t = Themes[name]; if not t then return end
    curTheme = name
    local a, l = t.Accent, t.Light
    for _, bg in ipairs(themeObjects.Toggles) do
        if bg.BackgroundColor3 == Color3.fromRGB(130,90,255) or bg.BackgroundColor3 == Themes[curTheme].Accent then bg.BackgroundColor3 = a end
    end
    for _, btn in ipairs(themeObjects.Buttons) do btn.BackgroundColor3 = a end
    if themeObjects.Resize then themeObjects.Resize.BackgroundColor3 = a end
    if themeObjects.Underline then themeObjects.Underline.BackgroundColor3 = l end
    if themeObjects.UnderlineGrad then
        themeObjects.UnderlineGrad.Color = ColorSequence.new{ColorSequenceKeypoint.new(0,a), ColorSequenceKeypoint.new(1,l)}
    end
    if themeObjects.Ver then themeObjects.Ver.BackgroundColor3 = a end
    if themeObjects.Stroke then themeObjects.Stroke.Color = a end
    if themeObjects.ExecLabel then themeObjects.ExecLabel.BackgroundColor3 = a end
    if themeObjects.WatermarkStroke then themeObjects.WatermarkStroke.Color = a end
    if themeObjects.WatermarkTextStroke then themeObjects.WatermarkTextStroke.Color = a end
    if themeObjects.DragHandleStroke then themeObjects.DragHandleStroke.Color = a end
    for _, p in ipairs(themeObjects.Particles) do p.BackgroundColor3 = l end
end

