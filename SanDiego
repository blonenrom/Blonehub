-- Fuel
local FULL_ANGLE = 175
local EMPTY_ANGLE = -108
local function getFuelPercent()
    local vg = player.PlayerGui:FindFirstChild("VehicleGui")
    if not vg then return nil end
    local dials = vg:FindFirstChild("Dials")
    if not dials then return nil end
    local fuel = dials:FindFirstChild("Fuel")
    if not fuel then return nil end
    local needle = fuel:FindFirstChild("Needle", true)
    if needle then
        local angle = needle.Rotation
        local percent = (angle - EMPTY_ANGLE) / (FULL_ANGLE - EMPTY_ANGLE) * 100
        return math.clamp(math.floor(percent + 0.5), 0, 100)
    end
    return nil
end

local function flyTo(targetPos)
    while isFarming do
        local car = getCar()
        if not car then wait(0.5); return end
        local mainPart = getMainPart(car)
        if bodyVel.Parent ~= mainPart then bodyVel.Parent = mainPart; bodyGyro.Parent = mainPart end
        local toTarget = targetPos - mainPart.Position
        if toTarget.Magnitude <= 10 then bodyVel.Velocity = Vector3.zero; return end
        bodyVel.Velocity = toTarget.Unit * farmSpeed
        RunService.Heartbeat:Wait()
    end
end

local function autoRefuel()
    if not petrolEvent then return end
    if bodyVel then bodyVel.Velocity = Vector3.zero end

    flyTo(Vector3.new(6929.1, 17.3, 158.7))
    flyTo(Vector3.new(6929.1, 17.3, 158.7))
    flyTo(Vector3.new(6906.5, 17.3, 180.2))

    repeat
        petrolEvent:FireServer(true)
        local fuel = getFuelPercent()
        wait(0.2)
    until (fuel and fuel >= 100) or not isFarming

    petrolEvent:FireServer(false)

    flyTo(Vector3.new(6923.3, 17.3, 161.3))
end

local function stopFarm()
    if bodyVel then bodyVel:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
    bodyVel, bodyGyro = nil, nil
    if collisionUpdateLoop then
        collisionUpdateLoop:Disconnect()
        collisionUpdateLoop = nil
    end
    isFarming = false
    coroutine.wrap(function()
        setWorldCollisions(true)
    end)()
    if farmToggleSetState then
        farmToggleSetState(false)
    end
end

local function startFarm()
    if isFarming then stopFarm() end
    wait(0.1)

    local mainPart, car
    if farmMode == "Car" then
        car = getCar()
        if not car then return end
        mainPart = getMainPart(car)
        if not mainPart then return end
        unanchorCar(car)
        setWorldCollisions(false)
    else
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        mainPart = char.HumanoidRootPart
    end

    bodyVel = Instance.new("BodyVelocity"); bodyVel.MaxForce = Vector3.new(1e10,1e10,1e10); bodyVel.Velocity = Vector3.zero; bodyVel.P = 5000; bodyVel.Parent = mainPart
    bodyGyro = Instance.new("BodyGyro"); bodyGyro.MaxTorque = Vector3.new(1e10,1e10,1e10); bodyGyro.CFrame = mainPart.CFrame; bodyGyro.P = 5000; bodyGyro.Parent = mainPart
    isFarming = true

    local waypoints, actionFunc, delays, specialIndices
    if farmMode == "Car" then
        waypoints = waypointsCar; actionFunc = doActionCar; delays = delaysCar
        specialIndices = {[3]=true, [33]=true, [63]=true}
    else
        waypoints = waypointsPlayer; actionFunc = doActionPlayer; delays = delaysPlayer
        specialIndices = {[3]=true, [17]=true, [31]=true}
    end

    coroutine.wrap(function()
        local targetPart = mainPart
        local currentCar = car
        while isFarming do
            for i, target in ipairs(waypoints) do
                if not isFarming then break end

                while isFarming do
                    if farmMode == "Car" then
                        local newCar = getCar()
                        if not newCar then
                            local fresh = workspace:FindFirstChild("Camry6")
                            if fresh and fresh:IsA("Model") then tryEnterCar(fresh) end
                            wait(0.5)
                        elseif newCar ~= currentCar then
                            currentCar = newCar
                            local mp = getMainPart(currentCar)
                            if mp then bodyVel.Parent = mp; bodyGyro.Parent = mp; bodyGyro.CFrame = mp.CFrame; targetPart = mp end
                        end
                    else
                        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then isFarming=false; break end
                        targetPart = player.Character.HumanoidRootPart
                        bodyVel.Parent = targetPart; bodyGyro.Parent = targetPart
                    end

                    local pos = targetPart.Position
                    local toTarget = target - pos
                    local dist = toTarget.Magnitude
                    local dir = dist>0.001 and toTarget.Unit or Vector3.zero

                    if dist <= math.max(5, farmSpeed*0.02) then bodyVel.Velocity = Vector3.zero; break end
                    bodyVel.Velocity = dir * farmSpeed
                    RunService.Heartbeat:Wait()
                end

                if not isFarming then break end

                if farmMode == "Car" and i == 1 then
                    local fuel = getFuelPercent()
                    if fuel and fuel <= 25 then
                        autoRefuel()
                    end
                end

                if farmMode == "Car" and i == 9 and not boundaryRemoved then
                    boundaryRemoved = true
                    for _, obj in ipairs(game:GetDescendants()) do if obj.Name=="PlayerBoundary" then pcall(function() obj:Destroy() end) end end
                end

                if specialIndices[i] then wait(0.2) end
                actionFunc(i)

                local dly = delays[i]
                if dly then wait(dly) end
            end
        end
        stopFarm()
    end)()
end

