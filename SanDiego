local function stopNoRender()
    for prop, val in pairs(originalLighting) do pcall(function() Lighting[prop] = val end) end
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        for mat, color in pairs(originalTerrainColors) do
            if mat == "WaterTransparency" then
                pcall(function() terrain.WaterTransparency = color end)
            else
                pcall(function() terrain:SetMaterialColor(mat, color) end)
            end
        end
    end
    for part, orig in pairs(originalParts) do
        if part and part.Parent then
            pcall(function() part.Transparency = orig.Transparency; part.Material = orig.Material; part.Reflectance = orig.Reflectance; part.TextureID = orig.TextureID; part.MeshId = orig.MeshId; part.CastShadow = orig.CastShadow end)
        end
    end
    if noRenderConn then noRenderConn:Disconnect() end
    for _, guiChild in ipairs(playerGui:GetChildren()) do
        if guiChild.Name == "NoRenderBg" or guiChild.Name == "NoRenderText" then guiChild:Destroy() end
    end
    originalLighting = {}
    originalTerrainColors = {}
    originalParts = {}
end

local function toggleNoRender(state)
    if state and not noRenderActive then
        noRenderActive = true
        startNoRender()
    elseif not state and noRenderActive then
        noRenderActive = false
        stopNoRender()
    end
end

