                    TweenService:Create(themeList, TweenInfo.new(0.3,Enum.EasingStyle.Quad),{Size = UDim2.new(1, 0, 0, 0)}):Play()
                    TweenService:Create(themeBlock, TweenInfo.new(0.3,Enum.EasingStyle.Quad),{Size = UDim2.new(0.92, 0, 0, 36)}):Play()
                end
            end)
        end

        local themeExpanded = false
        local themeListHeight = 5*30 + 4*4

        themeHeaderBtn.MouseButton1Click:Connect(function()
            themeExpanded = not themeExpanded
            themeHeaderBtn.Text = themeExpanded and "  ▼ Theme" or "  ▶ Theme"
            local targetListH = themeExpanded and themeListHeight or 0
            local targetBlockH = themeExpanded and (36 + targetListH) or 36
            TweenService:Create(themeList, TweenInfo.new(0.3,Enum.EasingStyle.Quad),{Size = UDim2.new(1, 0, 0, targetListH)}):Play()
            TweenService:Create(themeBlock, TweenInfo.new(0.3,Enum.EasingStyle.Quad),{Size = UDim2.new(0.92, 0, 0, targetBlockH)}):Play()
        end)

        partHeaderBtn.MouseButton1Click:Connect(function()
            particlesExpanded = not particlesExpanded
            local targetH = particlesExpanded and (36 + expandedHeight) or 36
            TweenService:Create(particlesBlock, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
                Size = UDim2.new(0.92, 0, 0, targetH)
            }):Play()
            local newThemeY = 4 + targetH + 4
            TweenService:Create(themeBlock, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
                Position = UDim2.new(0, 10, 0, newThemeY)
            }):Play()
        end)
    end
end

-- Tab switching
local curTab = tabBtns[1]   -- About
local curIdx = 1
for i,btn in ipairs(tabBtns) do
    btn.MouseButton1Click:Connect(function()
        if curIdx == i then return end
        curIdx = i
        for j,f in ipairs(tabFrames) do f.Visible = (j==i) end
        for _,b in ipairs(tabBtns) do
            if b == btn then
                TweenService:Create(b, TweenInfo.new(0.3), {BackgroundTransparency = 0.1, BackgroundColor3 = Themes[curTheme].Accent, TextColor3 = Color3.fromRGB(255,255,255)}):Play()
            else
                TweenService:Create(b, TweenInfo.new(0.3), {BackgroundTransparency = 0.5, BackgroundColor3 = Color3.fromRGB(40,38,58), TextColor3 = Color3.fromRGB(210,200,230)}):Play()
            end
        end
    end)
end

-- Drag
local drag,di,ds,sp
titleBar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true; ds=i.Position; sp=main.Position; i.Changed:Connect(function() if i.UserInputState==Enum.UserInputState.End then drag=false end end) end end)
titleBar.InputChanged:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then di=i end end)
UserInputService.InputChanged:Connect(function(i) if i==di and drag then local d=i.Position-ds; main.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y) end end)

-- Opening animation
main.Size=UDim2.new(0,0,0,0); main.Position=UDim2.new(0.5,0,0.5,0)
TweenService:Create(main,TweenInfo.new(0.5,Enum.EasingStyle.Back),{Size=UDim2.new(0,450,0,380),Position=UDim2.new(0.5,-225,0.5,-190)}):Play()

