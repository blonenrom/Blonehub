function getMainPart(model)
    if model.PrimaryPart then return model.PrimaryPart end
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") and (part.Name:lower()=="base" or part.Name:lower()=="chassis" or part.Name:lower()=="root") then
            model.PrimaryPart = part; return part
        end
    end
    local best, maxSize = nil, 0
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then local sz=part.Size.Magnitude; if sz>maxSize then maxSize=sz; best=part end end
    end
    if best then model.PrimaryPart=best; return best end
    local root = Instance.new("Part"); root.Name="FlightRoot"; root.Size=Vector3.new(0.5,0.5,0.5); root.Transparency=1; root.Anchored=false; root.CanCollide=false; root.Parent=model; model.PrimaryPart=root; return root
end

