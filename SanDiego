-- ==================== DYNAMIC PARTICLES ====================
local pCont = Instance.new("Frame"); pCont.Size=UDim2.new(1,0,1,0); pCont.BackgroundTransparency=1; pCont.ZIndex=1; pCont.Parent=mainCanvas

local particlesList = {}
local particleData = {}

local function clearParticles()
    for _, data in ipairs(particleData) do data.frame:Destroy() end
    particlesList = {}
    particleData = {}
end

local function createParticles()
    clearParticles()
    if not particlesEnabled then return end
    for i = 1, particleCount do
        local p = Instance.new("Frame")
        p.Size = UDim2.new(0, particleSize, 0, particleSize)
        p.Position = UDim2.new(math.random(), 0, math.random(), 0)
        p.BackgroundColor3 = Themes[curTheme].Light
        p.BackgroundTransparency = 0.6
        p.BorderSizePixel = 0
        p.ZIndex = 1
        p.Parent = pCont
        table.insert(themeObjects.Particles, p)
        Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
        table.insert(particlesList, p)
        table.insert(particleData, {
            frame = p,
            originalOffset = Vector2.new(math.random(-particleSpread, particleSpread), math.random(-particleSpread, particleSpread)),
            velocity = Vector2.zero,
            startTime = tick(),
            convergeDelay = math.random(1, 4)
        })
    end
end
createParticles()

local function updateParticles(dt)
    if not particlesEnabled then return end
    local mouseLocation = UserInputService:GetMouseLocation()
    local guiPos = main.AbsolutePosition
    local currentTime = tick()
    dt = dt or 0.016
    for _, data in ipairs(particleData) do
        data.frame.Size = UDim2.new(0, particleSize, 0, particleSize)
        local elapsed = currentTime - data.startTime
        local t = math.min(elapsed / data.convergeDelay, 1.0)
        local offset = attractToCursor and (data.originalOffset * (1 - t)) or data.originalOffset
        local targetPos = Vector2.new(mouseLocation.X + 10, mouseLocation.Y - 35) + offset
        local currentPos = Vector2.new(data.frame.AbsolutePosition.X, data.frame.AbsolutePosition.Y)
        currentPos = currentPos + data.velocity * dt
        data.velocity = data.velocity * 0.9
        local lerpFactor = math.clamp(particleSmoothness * dt * 60, 0, 1)
        currentPos = currentPos:Lerp(targetPos, lerpFactor)
        data.frame.Position = UDim2.new(0, currentPos.X - guiPos.X, 0, currentPos.Y - guiPos.Y)
    end
end
RunService.RenderStepped:Connect(updateParticles)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not particlesEnabled then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mousePos = UserInputService:GetMouseLocation()
        local mainPos = main.AbsolutePosition
        local mainSize = main.AbsoluteSize
        if main.Visible and mousePos.X >= mainPos.X and mousePos.X <= mainPos.X + mainSize.X and
           mousePos.Y >= mainPos.Y and mousePos.Y <= mainPos.Y + mainSize.Y then
            for _, data in ipairs(particleData) do
                local particlePos = Vector2.new(data.frame.AbsolutePosition.X, data.frame.AbsolutePosition.Y)
                local direction = (particlePos - mousePos).Unit
                local strength = math.random(300, 600) * particleSpeed
                data.velocity = data.velocity + direction * strength
                data.startTime = tick()
            end
        end
    end
end)

-- ==================== FPS COUNTER ====================
local fpsCounter = {frames = 0, lastTime = tick(), value = 0}
local function updateFPS()
    fpsCounter.frames = fpsCounter.frames + 1
    local now = tick()
    if now - fpsCounter.lastTime >= 0.5 then
        fpsCounter.value = fpsCounter.frames / (now - fpsCounter.lastTime)
        fpsCounter.frames = 0
        fpsCounter.lastTime = now
    end
end
RunService.Heartbeat:Connect(updateFPS)

